REF_H5AD = str(Path(config["ref_out"]) / config["ref_file"])
REF_RDS = str(Path(config["ref_out"]) / config["ref_rds"])
# Per-sample cohort path templates (Snakemake: outputs must be static strings, not functions)
COHORTS = "|".join(sorted(SAMPLES["cohort"].unique()))
PROCESSED = "data/processed/{cohort}"
H5AD_OUT = f"{PROCESSED}/spatial_{{label}}.h5ad"
H5AD_NONTUMOR = f"{PROCESSED}/spatial_{{label}}_nontumor.h5ad"
