def seurat_convert_labels():
    return SAMPLES[SAMPLES.run_seurat_transfer | SAMPLES.run_cellestimate].index.tolist()


def transfer_labels():
    return SAMPLES[SAMPLES.run_seurat_transfer].index.tolist()


def cellestimate_labels():
    return SAMPLES[SAMPLES.run_cellestimate].index.tolist()


def cell2location_labels():
    return SAMPLES[SAMPLES.run_cell2location].index.tolist()


def morans_labels():
    return SAMPLES[SAMPLES.run_morans_i].index.tolist()


def assemble_labels():
    """Labels eligible for assemble_loupe (any enabled annotation method)."""
    mask = (
        SAMPLES.run_seurat_transfer
        | SAMPLES.run_cellestimate
        | SAMPLES.run_cell2location
    )
    return SAMPLES[mask].index.tolist()


def unfiltered_seurat_labels():
    mask = (SAMPLES.run_seurat_transfer | SAMPLES.run_cellestimate) & ~SAMPLES.run_nontumor_filter
    return SAMPLES[mask].index.tolist()


def filtered_seurat_labels():
    mask = (SAMPLES.run_seurat_transfer | SAMPLES.run_cellestimate) & SAMPLES.run_nontumor_filter
    return SAMPLES[mask].index.tolist()


def unfiltered_transfer_labels():
    return SAMPLES[SAMPLES.run_seurat_transfer & ~SAMPLES.run_nontumor_filter].index.tolist()


def filtered_transfer_labels():
    return SAMPLES[SAMPLES.run_seurat_transfer & SAMPLES.run_nontumor_filter].index.tolist()


def unfiltered_cellestimate_labels():
    return SAMPLES[SAMPLES.run_cellestimate & ~SAMPLES.run_nontumor_filter].index.tolist()


def filtered_cellestimate_labels():
    return SAMPLES[SAMPLES.run_cellestimate & SAMPLES.run_nontumor_filter].index.tolist()


def unfiltered_cell2location_labels():
    return SAMPLES[SAMPLES.run_cell2location & ~SAMPLES.run_nontumor_filter].index.tolist()


def filtered_cell2location_labels():
    return SAMPLES[SAMPLES.run_cell2location & SAMPLES.run_nontumor_filter].index.tolist()


def unfiltered_morans_labels():
    return SAMPLES[SAMPLES.run_morans_i & ~SAMPLES.run_nontumor_filter].index.tolist()


def filtered_morans_labels():
    return SAMPLES[SAMPLES.run_morans_i & SAMPLES.run_nontumor_filter].index.tolist()


def unfiltered_assemble_labels():
    mask = (
        SAMPLES.run_seurat_transfer
        | SAMPLES.run_cellestimate
        | SAMPLES.run_cell2location
    ) & ~SAMPLES.run_nontumor_filter
    return SAMPLES[mask].index.tolist()


def filtered_assemble_labels():
    mask = (
        SAMPLES.run_seurat_transfer
        | SAMPLES.run_cellestimate
        | SAMPLES.run_cell2location
    ) & SAMPLES.run_nontumor_filter
    return SAMPLES[mask].index.tolist()


include: "rules/preprocess.smk"
include: "rules/filter_spots.smk"
include: "rules/morans_i.smk"
include: "rules/seurat.smk"
include: "rules/cellestimate.smk"
include: "rules/cell2location.smk"
include: "rules/assemble_loupe.smk"


rule all:
    input:
        [loupe_path(config, label, SAMPLES) for label in assemble_labels()],
